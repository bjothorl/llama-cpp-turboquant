[Unit]
Description=llama.cpp TurboQuant HTTP server (Qwen3.6-35B-A3B-MTP-UD-IQ4_XS)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# llama-server reads LLAMA_API_KEY from the environment (no --api-key needed)
PassEnvironment=LLAMA_API_KEY
WorkingDirectory=/home/b/repos/llama-cpp-turboquant
ExecStart=/home/b/repos/llama-cpp-turboquant/build/bin/llama-server \
#  -hf unsloth/Qwen3.6-27B-MTP-GGUF:UD-Q4_K_XL \
  -hf unsloth/Qwen3.6-35B-A3B-MTP-GGUF:UD-IQ4_XS \
# --temp 0.6 \
# --top-p 0.95 \
# --top-k 20 \
# --presence-penalty 0.1 \
# --min-p 0.00 \
  --spec-type draft-mtp \
  --spec-draft-n-max 2 \
  --host 0.0.0.0 \
  --port 8080 \
  -ngl 99 \
  -fa on \
  -c 131072 \
  -np 1 \
  -ctk turbo3 \
  -ctv turbo3

#  -hf unsloth/Qwen3.6-35B-A3B-MTP-GGUF:UD-IQ4_XS \
#  --host 0.0.0.0 \
#  --port 8080 \
#  -ngl 99 \
#  -fa on \
#  -c 131072 \
#  -np 1 \
#  --spec-type draft-mtp \
#  --spec-draft-n-max 2 \
#  -ctk turbo3 \
#  -ctv turbo3

# Restart after crashes (non-zero exit, signals, timeouts). Not after manual stop.
Restart=on-failure
RestartSec=15

# Optional extras (HF_TOKEN, CUDA vars) — one KEY=value per line
# EnvironmentFile=-%h/.config/llama-server/env
GGML_CUDA_ENABLE_UNIFIED_MEMORY=1

[Install]
WantedBy=default.target
