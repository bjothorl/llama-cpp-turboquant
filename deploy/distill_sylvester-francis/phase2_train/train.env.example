# Copy to train.env. CLI args override env values.

BASE_MODEL=Qwen/Qwen3.5-9B
DATA_PATH=deploy/distill_sylvester-francis/data/train_small.jsonl
OUTPUT_DIR=adapters/qwen35-9b-ts-smoke

# Training
MAX_SAMPLES=100
EPOCHS=1
BATCH_SIZE=1
GRAD_ACCUM=16
LEARNING_RATE=1e-4
WARMUP_RATIO=0.03
WEIGHT_DECAY=0.0
MAX_SEQ_LENGTH=1024
LOGGING_STEPS=5
SAVE_STEPS=100
SEED=42

# LoRA — low rank to protect MTP-friendly distribution.
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
# all-linear lets PEFT auto-discover linear modules in Qwen3.5's
# Gated DeltaNet + attention layers (names differ from Qwen2.5).
LORA_TARGETS=all-linear

# Quantization
USE_4BIT=true
BNB_4BIT_QUANT_TYPE=nf4
BNB_4BIT_USE_DOUBLE_QUANT=true
BNB_4BIT_COMPUTE_DTYPE=bfloat16
