# Copy to .env. Do not commit a real .env file.
#
# Optional. Qwen/Qwen3.5-9B and unsloth/Qwen3.5-9B-MTP-GGUF are un-gated,
# so anonymous downloads work. Set HF_TOKEN only if you hit rate limits
# or the repo becomes gated.
# HF_TOKEN=replace-me

# Optional. Only needed if you ask fetch_sylvester.sh to run his GitHub scraper.
# GITHUB_TOKEN=replace-me

# Where to clone sylvester-francis/slm-typescript-model. Defaults to home dir.
SYLVESTER_REPO=${HOME}/slm-typescript-model

# Path to this llama.cpp checkout.
LLAMA_CPP_ROOT=/home/b/repos/llama-cpp-turboquant
