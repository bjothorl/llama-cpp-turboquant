INPUT=deploy/distill/phase1/outputs/pilot.jsonl
OUTPUT=deploy/distill/phase2/outputs/pilot.verified.jsonl
WORKDIR=deploy/distill/phase2/outputs/work
TIMEOUT=60

# Shared Node/TypeScript dependency sandbox.
# When INSTALL_NODE_DEPS=true, npm install runs once here and each sample
# workdir symlinks this sandbox's node_modules instead of reinstalling packages.
NODE_SANDBOX=deploy/distill/phase2/outputs/node_sandbox

# Optional. If true, keep per-sample work directories after verification.
KEEP_WORKDIR=true

# Optional. If true, run npm install once in NODE_SANDBOX and reuse its
# node_modules for each Node/TypeScript sample workdir.
INSTALL_NODE_DEPS=false

# Repair-loop defaults. The repair script reads failed samples from REPAIR_INPUT,
# sends deterministic repair prompts to the local teacher, and writes repaired
# samples to REPAIR_OUTPUT without mutating the original JSONL.
REPAIR_INPUT=deploy/distill/phase2/outputs/pilot.verified.jsonl
REPAIR_OUTPUT=deploy/distill/phase2/outputs/pilot.repaired.jsonl
REPAIR_MODEL=phase2-repair-teacher
REPAIR_MAX_TOKENS=2048
REPAIR_TEMPERATURE=0.2
REPAIR_TOP_P=0.95

# Optional chunking for large repair runs. REPAIR_OFFSET skips repairable rows;
# REPAIR_MAX_REPAIRS limits how many are sent to the teacher in one run.
REPAIR_OFFSET=0
# REPAIR_MAX_REPAIRS=100
